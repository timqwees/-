# .htaccess — ФАВОРИТ-СТРОЙ-СНАБ (nginx-эквивалент: tools/nginx.conf)
# Ядро (app/, setting/) вне прямых URL; контент в public/; вход — index.php (роутер).

# --- 1. Редиректы и ЧПУ (фронт-контроллер index.php) ---
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# HTTPS + единый хост www.xn--h1aafj.xn--p1ai — ОДНИМ редиректом (без цепочек http→https→www)
	RewriteCond %{HTTPS} !=on [OR]
	RewriteCond %{HTTP_HOST} !^www\.xn--h1aafj\.xn--p1ai$ [NC]
	RewriteRule ^(.*)$ https://www.xn--h1aafj.xn--p1ai/$1 [R=301,L]

	# SEO-фиды и AI-файлы — всегда через PHP-роутер (динамика, ETag/304)
	RewriteRule ^(robots\.txt|sitemap\.xml|sitemap-index\.xml|rss\.xml|turbo\.xml|yml\.xml|feed\.yml|llms\.txt|llms-full\.txt|opensearch\.xml|ai-plugin\.json|openapi\.yaml)$ index.php [L]

	# Старые .php-адреса → ЧПУ (301, защита от дублей; дублирует routes.php)
	RewriteRule ^index\.php$ / [R=301,L]
	RewriteRule ^home\.php$ / [R=301,L]
	RewriteRule ^pages/uslugi/uslugi\.php$ /uslugi [R=301,L]
	RewriteRule ^pages/portfolio\.php$ /portfolio [R=301,L]
	RewriteRule ^pages/projects\.php$ /portfolio [R=301,L]
	RewriteRule ^pages/politic/index\.php$ /politika [R=301,L]
	RewriteRule ^pages/agree/index\.php$ /soglasie [R=301,L]
	RewriteRule ^pages/services/([a-z0-9_\-]+)/index\.php$ /services/$1 [R=301,L]
	RewriteRule ^pages/services/([a-z0-9_\-]+)/?$ /services/$1 [R=301,L]
	# До переезда в public/: /assets/* → /public/assets/*
	RewriteRule ^assets/(.+)$ /public/assets/$1 [R=301,L]

	# Двойные и висячие слэши
	RewriteCond %{REQUEST_URI} ^(.*)//(.*)$
	RewriteRule . %1/%2 [R=301,L]
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^(.+)/$ /$1 [R=301,L]

	# Закрытое: ядро, исходники, шаблоны и данные напрямую не отдаём (только через роутер)
	RewriteRule ^(app|setting|vendor|tools)/ - [F,L]
	RewriteRule ^public/pages/ - [F,L]

	# Контент-негоциация изображений: AVIF → WebP → оригинал (по Accept браузера, без правки шаблонов)
	RewriteCond %{HTTP_ACCEPT} image/avif [NC]
	RewriteCond %{REQUEST_FILENAME}\.avif -f
	RewriteRule ^(.+\.(?:jpe?g|png|webp))$ $1.avif [T=image/avif,L]
	RewriteCond %{HTTP_ACCEPT} image/webp [NC]
	RewriteCond %{REQUEST_FILENAME}\.webp -f
	RewriteRule ^(.+\.(?:jpe?g|png))$ $1.webp [T=image/webp,L]

	# Всё остальное — фронт-контроллер (существующие файлы отдаются напрямую)
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^(.*)$ index.php [L]
</IfModule>

# --- 2. Ошибки: несуществующие URL уходит в роутер правилом выше (честный 404-шаблон) ---

# --- 3. Заголовки безопасности (HTML ставит PHP/SecurityHeaders; здесь только статика) ---
<IfModule mod_headers.c>
	Header set X-Content-Type-Options "nosniff"
	Header set X-Frame-Options "SAMEORIGIN"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
	Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
	Header set Cross-Origin-Opener-Policy "same-origin-allow-popins"
	Header set X-DNS-Prefetch-Control "on"
    # HSTS (HTTPS-only: сайт работает через https://www.фсс.рус/)
    Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

	<FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|mp4|css|js|woff2|ico)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>

	# Контент-негоциация зависит от Accept — обязательно Vary: Accept (кэш/CDN)
	<FilesMatch "\.(jpg|jpeg|png|webp|avif)$">
		Header append Vary "Accept"
	</FilesMatch>

	# Шаблоны напрямую не индексируем (если правило F выше снято)
	<If "%{REQUEST_URI} =~ m#^/public/pages/#">
		Header set X-Robots-Tag "noindex, nofollow"
	</If>
</IfModule>

# --- 4. Сжатие ---
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml font/woff2
</IfModule>
<IfModule mod_brotli.c>
	AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/rss+xml image/svg+xml font/woff2
</IfModule>

# --- 5. Кэш браузера (статика; HTML управляется из PHP) ---
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresDefault "access plus 1 week"
	ExpiresByType image/jpg "access plus 1 year"
	ExpiresByType image/jpeg "access plus 1 year"
	ExpiresByType image/png "access plus 1 year"
	ExpiresByType image/webp "access plus 1 year"
	ExpiresByType image/avif "access plus 1 year"
	ExpiresByType image/svg+xml "access plus 1 year"
	ExpiresByType video/mp4 "access plus 1 year"
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
FileETag MTime Size

# --- 6. Служебное ---
Options -Indexes -MultiViews
AddDefaultCharset UTF-8
DefaultLanguage ru
ServerSignature Off

<FilesMatch "^(composer\.(json|lock)|\.env|\.gitignore|\.dev)$">
	Require all denied
</FilesMatch>
<FilesMatch "\.(log|ini|conf|sql|md)$">
	Require all denied
</FilesMatch>

php_flag display_errors off
php_flag log_errors on
