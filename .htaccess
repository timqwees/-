# ==========================================================================
#  ФАВОРИТ-СТРОЙ-СНАБ (ФСС) — Apache / reg.ru shared
#  Обязателен: без него Apache не отдаёт ЧПУ и index.php не получает запрос.
#  Канон URL: HTTPS + www (совпадает с base_url в App\Config\site.php).
# ==========================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Безопасность: закрываем исходники и служебные файлы ----------------
  RewriteRule "(^|/)\.(?!well-known)" - [F]
  # var/ — очередь заявок (App\Mail\Outbox): там лежат ФИО и телефоны клиентов,
  # наружу отдавать нельзя. Правило для существующих файлов ниже отдаёт их «как есть».
  RewriteRule "^(app|setting|tools|vendor|docs|var)(/|$)" - [F,L]
  RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|\.env(\..*)?)$ - [F,L]
  RewriteRule ^public/(components|pages)(/|$) - [F,L]

  # --- Канон: https://www.<host> за один шаг (localhost/IP не трогаем) ----
  # Хост без www и порта — в переменную (expr не дружит с %N-бэкреференсами)
  RewriteCond %{HTTP_HOST} ^(?:www\.)?([^:]+)(?::\d+)?$ [NC]
  RewriteRule ^ - [E=BAREHOST:%1]

  RewriteCond %{ENV:BAREHOST} !^$
  RewriteCond %{ENV:BAREHOST} !^(localhost|127\.0\.0\.1)$ [NC]
  RewriteCond %{ENV:BAREHOST} !^(\d{1,3}\.){3}\d{1,3}$
  # редирект если не HTTPS (напрямую или через прокси) ИЛИ хост без www
  RewriteCond expr "(%{HTTPS} != 'on' && %{HTTP:X-Forwarded-Proto} != 'https') || (%{HTTP_HOST} !~ /^www\./)"
  RewriteRule ^ https://www.%{ENV:BAREHOST}%{REQUEST_URI} [R=301,L]

  # --- Чистка URL ---------------------------------------------------------
  RewriteCond %{REQUEST_URI} ^(.*)//(.*)$
  RewriteRule . %1/%2 [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # --- Маршрутизация ------------------------------------------------------
  # Существующий файл/каталог отдаём как есть (assets, .well-known, xml/json)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Всё остальное → front controller
  RewriteRule ^ index.php [L]
</IfModule>

DirectoryIndex index.php index.html

# --- Сжатие -------------------------------------------------------------
<IfModule mod_filter.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/ld+json image/svg+xml font/woff2
  </IfModule>
</IfModule>

FileETag MTime Size

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp   "access plus 1 year"
  ExpiresByType image/avif   "access plus 1 year"
  ExpiresByType image/jpeg   "access plus 1 year"
  ExpiresByType image/png    "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css     "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2   "access plus 1 year"
  ExpiresByType font/woff    "access plus 1 year"
</IfModule>

<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>
