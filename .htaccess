# .htaccess — FAVORIT-STROY-SNAB Professional
# Security + Performance + SEO

# --- Security Headers ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS (enable after SSL check)
  # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  # CSP — мягкий, разрешаем CDN
  Header set Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://api-maps.yandex.ru; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://cdn.tailwindcss.com; img-src 'self' data: https: blob:; font-src 'self' https://cdnjs.cloudflare.com data:; connect-src 'self' https:; frame-src 'self' https://yandex.ru https://api-maps.yandex.ru;"
</IfModule>

# --- Prevent access to sensitive files ---
<FilesMatch "^(composer\.(json|lock)|package\.json|webpack\.config\.js|site_pages\.conf|\.htaccess|\.env)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(log|ini|conf)$">
  Require all denied
</FilesMatch>

# Block direct access to PHP internals
RedirectMatch 403 ^/(vendor|node_modules|src)/.*$
RedirectMatch 403 ^/assets/PHP/(config|Antibot|Security|sheoma).*\.php$

# Hide PHP errors from users (SEO: no leaks)
php_flag display_errors off
php_flag log_errors on

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Browser Caching (Performance) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresDefault "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|mp4|css|js|woff2)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# --- SEO: Force HTTPS and www unification (choose one) ---
# Uncomment if domain is punycode and SSL ready
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   # Force HTTPS
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
#   # Optional: redirect фсс.рус -> www.фсс.рус
#   # RewriteCond %{HTTP_HOST} ^фсс\.рус$ [NC]
#   # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# --- Anti-bot: Block empty UA and known bad bots via rewrite ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Block no User-Agent (often spam bots)
  RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
  # Block common spam bots/crawlers that abuse forms
  RewriteCond %{HTTP_USER_AGENT} (curl|wget|python|libwww|httpclient|masscan|nmap|sqlmap|nikto) [NC]
  RewriteRule ^.* - [F,L]

  # Limit POST floods: optional rate via mod_ratelimit if available
</IfModule>

# --- Disable directory listing ---
Options -Indexes

# --- Error Documents (SEO friendly) ---
ErrorDocument 404 /index.php
ErrorDocument 403 /index.php

# --- UTF-8 ---
AddDefaultCharset UTF-8
DefaultLanguage ru

# --- Protect against clickjacking via meta if headers blocked ---
